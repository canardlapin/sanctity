# Illustrative TLS ingress; replace server name and certificate paths.
# Validate using your installed nginx -t before activation.
server {
    listen 443 ssl;
    server_name repository.example.org;
    ssl_certificate /etc/sanctity/tls/fullchain.pem;
    ssl_certificate_key /etc/sanctity/tls/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 2m;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host repository.example.org;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 60s;
        # Origin is passed unchanged for application checking; never replace it.
    }
    # Avoid URL queries, authorization and raw error context in shared logs.
    access_log off;
    error_log /var/log/nginx/sanctity-private-error.log crit;
}

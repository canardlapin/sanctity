# Illustrative protected environment; never source an untrusted file.
# Use absolute canonical paths (resolve symlinks with realpath first).
SANCTITY_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/sanctity
SANCTITY_DB_USER=sanctity_runtime
SANCTITY_DB_SCHEMA=sanctity
SANCTITY_DB_POOL_SIZE=4
SANCTITY_DB_PASSWORD_FILE=/etc/sanctity/runtime/database-password
SANCTITY_STORAGE=/var/lib/sanctity/blobs
SANCTITY_HTTP_PORT=8080
SANCTITY_DEPLOYMENT_MODE=loopback
SANCTITY_PUBLIC_ORIGIN=http://127.0.0.1:8080
SANCTITY_SHUTDOWN_SECONDS=10
# For the TLS proxy template, change mode to proxy and origin to
# https://repository.example.org. Do not expose the loopback listener.

# After explicit witness enrollment, retain this configuration outside primary backups.
# The client file and referenced inputs must be owned, canonical, mode 0600 in 0700 directories.
# SANCTITY_POLICY_CONFIG=/protected/sanctity-policy/writer.json
